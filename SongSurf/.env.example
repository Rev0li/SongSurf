# SongSurf — exemple de configuration
# Copier vers .env puis lancer : make secrets
# Le matériel de clés (mots de passe, clés hex) va dans .secrets — généré par make secrets.

# ── Déploiement ────────────────────────────────────────────────────────────
# local = bridge Docker, ports publiés en localhost (développement)
# nas   = network_mode host, réseau direct NAS (production)
DEPLOY_TARGET=local
WATCHER_PORT=8080
SONGSURF_PORT=8081

# ── Routage interne — calculé par make secrets selon SONGSURF_PORT ─────────
# local : Watcher → SongSurf via réseau Docker interne
TARGET_URL=http://songsurf:8081
# nas   : les deux sur le host, TARGET_URL_NAS utilisé à la place
TARGET_URL_NAS=http://localhost:8081

# ── Limites téléchargement ────────────────────────────────────────────────
# Titres par membre et par jour (l'admin est illimité). 0 = illimité pour tous.
DAILY_DOWNLOAD_LIMIT=0
MAX_DURATION_SECONDS=9000

# ── Arrêt automatique (inactivité) ────────────────────────────────────────
INACTIVITY_WARN_TIMEOUT=3600
INACTIVITY_GRACE_TIMEOUT=900

# ── Mode dev ─────────────────────────────────────────────────────────────
# true = aucune authentification — JAMAIS en production
DEV_MODE=false

# ── Portail rev0auth ──────────────────────────────────────────────────────
# L'auth est faite par le portail devant SongSurf (Caddy, preuve
# SONGSURF_PROXY_SECRET dans .secrets).
# URL de l'espace membre du portail — redirect après "← Mon espace" (logout)
REVAUTH_HOME_URL=
# UUID du compte admin du portail (X-User-Id de rev0auth) — NAS uniquement :
# la musique Jellyfin est montée sur /data/music/<ADMIN_UID> (docker-compose.nas.yml).
ADMIN_UID=

